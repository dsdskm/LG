{
    "$schema": "https://turborepo.dev/schema.json",
    "globalDependencies": [
        ".env"
    ],
    "globalEnv": [
        "RUN_IN_DOCKER",
        "PORT_SIMULATOR",
        "PORT_EVENT_GENERATOR",
        "PORT_EVENT_RECEIVER",
        "PORT_EVENT_ANALYZER",
        "PORT_LLM_GATEWAY",
        "PORT_WEB",
        "URL_LLM_GATEWAY",
        "URL_LLM_GATEWAY_CONTAINER",
        "DB_URL_EVENT_RECEIVER",
        "DB_URL_EVENT_ANALYZER",
        "NEXT_PUBLIC_EVENT_RECEIVER_URL",
        "NEXT_PUBLIC_EVENT_ANALYZER_URL=http",
        "SERVER_TIMEOUT",
        "GOOGLE_APPLICATION_CREDENTIALS",
        "GOOGLE_CLOUD_PROJECT",
        "GOOGLE_CLOUD_LOCATION",
        "VERTEX_MODEL_ID",
        "VERTEX_TEMPERATURE",
        "VERTEX_MAX_OUTPUT_TOKENS",
        "ERROR_CONTEXT_LINES",
        "GOOGLE_AUTH_URL",
        "AZURE_OPENAI_ENDPOINT",
        "AZURE_OPENAI_API_KEY",
        "AZURE_OPENAI_API_VERSION",
        "AZURE_OPENAI_DEPLOYMENT",
        "AZURE_OPENAI_MODEL",
        "AZURE_OPENAI_TIMEOUT_MS",
        "AZURE_OPENAI_MAX_TOKENS",
        "AZURE_ANSWER_PREVIEW_CHARS"
    ],
    "tasks": {
        "dev": {
            "cache": false,
            "persistent": true
        },
        "build": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                "dist/**",
                ".next/**",
                "!.next/cache/**"
            ]
        },
        "lint": {
            "dependsOn": [
                "^lint"
            ]
        },
        "test": {
            "dependsOn": [
                "^test"
            ]
        }
    }
}