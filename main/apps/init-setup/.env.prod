# Docker 배포: 브라우저 → nginx(frontend 컨테이너) → backend 컨테이너 로 프록시.
# 브라우저는 호스트에서 실행되므로 backend 컨테이너 이름(backend)으로 직접 접속할 수 없다.
# 대신 상대경로(/api)로 호출하면 nginx 가 같은 도커 네트워크의 backend 로 proxy_pass 한다.
# (nginx.conf 에 location /api { proxy_pass http://backend:3000; } 필요)
VITE_USE_RELATIVE_API=true
VITE_PROXY_SERVER_BASE_URL=https://dm.qa.hcrsp.com
VITE_WEBSOCKET_URL=ws://10.159.42.45:8765
# 상대경로로 두어 nginx 프록시를 태운다. slam 등 VITE_API_BASE_URL 직접 사용 코드도 동일 origin 으로 감.
VITE_API_BASE_URL=/api/v1
