# Jetson Orin(L4T) GPU 용 — 원본 Dockerfile(x86/CPU) 과 별개.
# 베이스: dusty-nv l4t-pytorch (Jetson용 torch + CUDA 포함, ROS 없음)
#   -> 여기에 ROS2 humble + ultralytics + mediapipe 설치.
# torch 는 베이스 것 그대로 사용(재설치 금지).
# 베이스 태그는 타겟 L4T 에 맞춤: cat /etc/nv_tegra_release (R36.4.x -> r36.4.0)

ARG BASE_IMAGE=dustynv/l4t-pytorch:r36.4.0
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=humble

# apt 가 IPv6 로 붙다 실패하는 환경 회피
RUN echo 'Acquire::ForceIPv4 "true";' > /etc/apt/apt.conf.d/99force-ipv4

# ---- ROS2 humble (ros-base) ----
RUN apt-get update && apt-get install -y --no-install-recommends \
    locales \
    software-properties-common \
    curl \
    gnupg2 && \
    locale-gen en_US en_US.UTF-8 && \
    add-apt-repository universe

RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
      -o /usr/share/keyrings/ros-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo $UBUNTU_CODENAME) main" \
      > /etc/apt/sources.list.d/ros2.list

RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-${ROS_DISTRO}-ros-base \
    ros-${ROS_DISTRO}-sensor-msgs \
    ros-${ROS_DISTRO}-std-msgs \
    ros-${ROS_DISTRO}-rmw-cyclonedds-cpp \
    ros-${ROS_DISTRO}-realsense2-camera \
    ros-${ROS_DISTRO}-realsense2-description \
    python3-colcon-common-extensions \
    libgl1 \
    libglib2.0-0 \
    fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

# ---- ultralytics / mediapipe ----
# 베이스 pip 가 jetson 전용 인덱스를 볼 수 있으므로, 일반 패키지는 PyPI 에서 받도록 명시.
ARG PYPI=https://pypi.org/simple

RUN pip3 install --no-cache-dir --index-url $PYPI --upgrade pip setuptools wheel

# torch 는 베이스 이미지의 Jetson용 torch를 유지해야 하므로 ultralytics는 --no-deps
RUN pip3 install --no-cache-dir --index-url $PYPI --no-deps ultralytics

RUN pip3 install --no-cache-dir --index-url $PYPI \
    opencv-python \
    pyyaml \
    tqdm \
    psutil \
    py-cpuinfo \
    pandas \
    requests \
    matplotlib \
    seaborn \
    pillow \
    ultralytics-thop \
    mediapipe \
    'numpy<2'

WORKDIR /ws

# 모델 사전 다운로드. 실패해도 빌드는 계속.
RUN python3 -c "from ultralytics import YOLO; YOLO('yolov8n-pose.pt')" || true

# import 확인. mediapipe가 Jetson 환경에서 설치 실패하면 여기서 빌드 실패하므로,
# 우선 확실히 실패를 알기 위해 || true를 붙이지 않음.
RUN python3 -c "import mediapipe as mp; print('mediapipe', mp.__version__)"

COPY scripts/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]